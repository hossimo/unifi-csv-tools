# Copy to .env (git-ignored) and fill in. One console needs nothing but a key:
UNIFI_API_KEY=your-key-here

# A second console goes in its own [profile] section, chosen with --profile
# <name> or UNIFI_PROFILE; [default] is used when neither names one. Keys left
# outside every section, like the one above, are shared by all of them.
#
# [default]
# host = 192.168.1.1
# api_key = key-for-the-main-console
#
# [branch]
# host = 10.10.0.1
# api_key = key-for-the-branch-console
# site = branch          # optional, default: default
# port = 443             # optional, default: 443
# verify_ssl = false     # optional, default: false
